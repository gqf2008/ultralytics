{
    "$schema": "https://schema.tauri.app/config/2.0.0",
    "productName": "YOLOv8 Sentinel",
    "version": "0.1.0",
    "identifier": "com.ultralytics.yolov8-sentinel",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "YOLOv8 实时监控",
                "width": 1280,
                "height": 720,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "devtools": true,
                "transparent": true,
                "visible": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false
    }
}